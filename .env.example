# Browser-safe Vite variables. These are bundled into the frontend.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
VITE_BACKEND_PROVIDER=supabase

# Build-only release guard. Netlify CONTEXT selects preview/production automatically.
# Configure separately per hosting context; previews require a distinct test DB.
# PLANTIE_RELEASE_ENV=production
# PLANTIE_RELEASE_PLATFORM=web
# PLANTIE_PRODUCTION_SUPABASE_URL=https://production-project.supabase.co
# PLANTIE_TEST_SUPABASE_URL=https://authorized-test-project.supabase.co

# Optional rollback toggles.
# VITE_DISABLE_SUPABASE_READS=true
# VITE_DISABLE_SUPABASE_WRITES=true
# VITE_ENABLE_NETLIFY_LEGACY_BACKEND=true

# RevenueCat public SDK keys. Local web can use an optional Web Billing sandbox key;
# native development and test builds use Test Store. Never use a secret API key here.
# The live web deployment currently uses Test Store by explicit user selection.
VITE_REVENUECAT_BILLING_MODE=test_store
# VITE_REVENUECAT_API_KEY_TEST_STORE=test_public_key
# Keep false until RevenueCat restore behavior is verified as Keep with original App User ID.
VITE_REVENUECAT_HOUSEHOLD_NATIVE_BILLING_ENABLED=false
# VITE_REVENUECAT_API_KEY_IOS=appl_public_key
# VITE_REVENUECAT_API_KEY_ANDROID=goog_public_key
# VITE_REVENUECAT_API_KEY_WEB=rcb_public_web_key
# Put this public sandbox key in .env.development.local for local web checkout only.
# VITE_REVENUECAT_API_KEY_WEB_SANDBOX=rcb_sb_public_web_sandbox_key

# Server-only variables for Netlify Functions or Supabase Edge Function secrets.
# Never prefix these with VITE_ and never expose real values in committed files.
# Legacy token/AI APIs and scheduled reports/push are disabled by default.
# Internal rollback only: ENABLE_NETLIFY_LEGACY_BACKEND=true
# A VITE_ rollback flag alone does not enable server access.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
OPENAI_API_KEY=server-only-openai-key
OPENAI_MODEL=gpt-4o
# Optional, server-only: random secret of at least 32 characters. Empty retains
# server-side AI revalidation; never add a VITE_ version of this value.
IMAGE_VALIDATION_SIGNING_SECRET=
# Operational mail is disabled by default. Enabling also requires operator UUIDs.
ENABLE_TEST_EMAIL=false
TEST_EMAIL_OPERATOR_IDS=
REVENUECAT_WEBHOOK_SECRET=server-only-shared-secret
# Test Store mode accepts TEST_STORE/SANDBOX; Web Billing sandbox has a separate opt-in below.
REVENUECAT_BILLING_MODE=test_store
# Enable only on a separate disposable test backend with sandbox webhooks.
REVENUECAT_ALLOW_SANDBOX_EVENTS=false
# Explicit Web Billing sandbox testing; also works alongside Test Store mode.
# This admits only signed RC_BILLING/SANDBOX events, not other providers.
REVENUECAT_ALLOW_WEB_BILLING_SANDBOX_EVENTS=false
RESEND_API_KEY=server-only-resend-key
RESEND_FROM_EMAIL=Plantie <no-reply@example.com>
APP_PUBLIC_URL=https://your-app.example.com
# Signed Supabase Send Email Auth Hook; use the same secret in Auth Hooks config.
SEND_EMAIL_HOOK_SECRET=v1,whsec_base64-secret
RESEND_TEST_EMAIL=qa@example.com
REPORT_FROM_EMAIL=Plantie <no-reply@example.com>
NETLIFY_SITE_ID=your-netlify-site-id
NETLIFY_BLOBS_TOKEN=server-only-netlify-blobs-token
VAPID_PUBLIC_KEY=browser-push-public-key
VAPID_PRIVATE_KEY=server-only-browser-push-private-key
VAPID_SUBJECT=mailto:admin@example.com
